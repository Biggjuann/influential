# ── ML providers ─────────────────────────────────────────────────────────

# Anthropic — used for persona writing, captions, scripts
ANTHROPIC_API_KEY=

# fal.ai — used for image + video + voice + lipsync
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# Optional fal endpoint overrides — set if you want to swap models without
# redeploying code. Leave blank for the defaults (current best open models).
FAL_ENDPOINT_FLUX=
FAL_ENDPOINT_FLUX_ID=
FAL_ENDPOINT_VIDEO_I2V=
FAL_ENDPOINT_TTS_CLONE=
FAL_ENDPOINT_TTS_FALLBACK=
FAL_ENDPOINT_LIPSYNC=

# Set to "1" to use mock provider responses (no API costs, useful for UI dev)
USE_MOCK_PROVIDERS=0

# ── Database ─────────────────────────────────────────────────────────────

# Postgres connection string. Railway injects this automatically when you
# attach a Postgres add-on (DATABASE_URL).
DATABASE_URL=

# ── Object storage (S3 / Cloudflare R2 / Backblaze etc) ──────────────────

# Bucket name (e.g. "influential-assets")
S3_BUCKET=

# Public URL prefix that your bucket files are served from. fal.ai must be
# able to fetch reference images via this URL during multi-step pipelines.
#  - Cloudflare R2: https://pub-<id>.r2.dev   (or your custom domain)
#  - AWS S3:        https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL=

# Endpoint URL. Omit for AWS S3, set for R2/B2/MinIO/etc.
#  - Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=

# Region. "auto" works for R2; AWS uses e.g. "us-east-1".
S3_REGION=auto

# Credentials (use a scoped IAM/R2 token, NOT your account root keys)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set to "1" for path-style URLs (MinIO etc). Leave unset for R2/S3.
S3_FORCE_PATH_STYLE=

# ── Public domain (set automatically by Railway) ─────────────────────────

# Override the auto-detected base URL if you use a custom domain.
PUBLIC_BASE_URL=

# ── ML providers ─────────────────────────────────────────────────────────

# Anthropic — used for persona writing, captions, scripts
ANTHROPIC_API_KEY=

# fal.ai — used for image + video + voice + lipsync
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# Optional fal endpoint overrides — set if you want to swap models without
# redeploying code. Leave blank for the defaults.
#
# Image (one per quality mode):
FAL_ENDPOINT_FLUX_DRAFT=          # default fal-ai/flux/schnell
FAL_ENDPOINT_FLUX=                # default fal-ai/flux/dev (standard)
FAL_ENDPOINT_FLUX_PREMIUM=        # default fal-ai/flux/dev
FAL_ENDPOINT_FLUX_ID=             # default fal-ai/flux-pulid (face-locked, all modes)
#
# Video (one per quality mode):
FAL_ENDPOINT_VIDEO_I2V_DRAFT=     # default fal-ai/ltx-video-v095/image-to-video
FAL_ENDPOINT_VIDEO_I2V=           # default fal-ai/kling-video/v1.6/standard/image-to-video
FAL_ENDPOINT_VIDEO_I2V_PREMIUM=   # default fal-ai/wan-pro/image-to-video
#
# Voice + lipsync:
FAL_ENDPOINT_TTS_CLONE=
FAL_ENDPOINT_TTS_FALLBACK=
FAL_ENDPOINT_LIPSYNC=

# Pipeline feature flags (default: off, to keep cost predictable while you
# verify the rest of the pipeline). Flip to "1" to enable.
#  - VOICE_ENABLED=1 generates voiceover audio for each video
#  - LIPSYNC_ENABLED=1 runs LatentSync on top of voice (requires VOICE_ENABLED=1)
# Voice + lipsync roughly double the per-video cost and >5x the time. Many
# TikTok formats work fine without them (silent video + caption overlay).
VOICE_ENABLED=0
LIPSYNC_ENABLED=0

# Per-step fal timeout in milliseconds (default 8 min)
FAL_TIMEOUT_MS=

# Set to "1" to use mock provider responses (no API costs, useful for UI dev)
USE_MOCK_PROVIDERS=0

# ── Database ─────────────────────────────────────────────────────────────

# Postgres connection string. Railway injects this automatically when you
# attach a Postgres add-on (DATABASE_URL).
DATABASE_URL=

# ── Object storage (S3 / Cloudflare R2 / Backblaze etc) ──────────────────

# Bucket name (e.g. "influential-assets")
S3_BUCKET=

# Public URL prefix that your bucket files are served from. fal.ai must be
# able to fetch reference images via this URL during multi-step pipelines.
#  - Cloudflare R2: https://pub-<id>.r2.dev   (or your custom domain)
#  - AWS S3:        https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL=

# Endpoint URL. Omit for AWS S3, set for R2/B2/MinIO/etc.
#  - Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=

# Region. "auto" works for R2; AWS uses e.g. "us-east-1".
S3_REGION=auto

# Credentials (use a scoped IAM/R2 token, NOT your account root keys)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set to "1" for path-style URLs (MinIO etc). Leave unset for R2/S3.
S3_FORCE_PATH_STYLE=

# ── Public domain (set automatically by Railway) ─────────────────────────

# Override the auto-detected base URL if you use a custom domain.
PUBLIC_BASE_URL=
